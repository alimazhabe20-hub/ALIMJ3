# Rooze Ziba / ALIMJ — V58 production configuration
# Copy this file to .env and set the required secrets/values.
# Never commit a real .env file.

# Required
BOT_TOKEN=
ADMIN_IDS=

# Force-join (enabled by default; keep enabled for mandatory membership)
FORCE_JOIN_ENABLED=true
CHANNEL_ID=
CHANNEL_LINK=

# Core runtime
TIMEZONE=Asia/Tehran
PRAYER_METHOD=7
CACHE_TTL=300
RATE_LIMIT=300
START_RATE_LIMIT=10
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
DB_PATH=
BACKUP_DIR=
BACKUP_KEEP=14
RESTORE_MAX_BYTES=268435456
AUTOMATION_DIGEST_HOUR=8

# HTTP / resilience
HTTP_TIMEOUT=15
HTTP_DEFAULT_TIMEOUT=15
HTTP_RETRIES=2
HTTP_RETRY_BACKOFF=0.25
HTTP_GET_CACHE_TTL=12
HTTP_GET_CACHE_MAX=512
HTTP_429_MAX_DELAY=10
MARKET_HTTP_RETRIES=0

# AI runtime
AI_TIMEOUT=40
AI_MAX_INPUT=6000
AI_MAX_OUTPUT=2800
AI_HISTORY_ITEMS=8
AI_KEY_COOLDOWN_SEC=43200
AI_KEY_SHORT_COOLDOWN_SEC=90
AI_RETRY_COUNT=2
AI_RETRY_BASE_SEC=0.25
AI_SIMPLE_MAX_CHARS=220
AI_COMPLEX_MIN_CHARS=1200
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_SEC=45
AI_PROVIDER_MAX_COOLDOWN_SEC=300
AI_ROUTING_MODE=balanced
AI_ROUTING_COST_WEIGHT=0.35
AI_ROUTING_QUALITY_WEIGHT=0.65
AI_ROUTING_LATENCY_WEIGHT=0
AI_TOOL_TIMEOUT=25
AI_TOOL_CONCURRENCY=8
AI_TOOL_CACHE_TTL=60
AI_TOOL_CACHE_MAX=1024
AI_AGENT_MAX_REPAIRS=2
AI_WORKFLOW_MAX_RESULT_CHARS=12000
AI_WORKFLOW_MAX_STEPS=8
AI_STREAM_CHUNK=1200
AI_MODEL_PROFILES=

# AI providers/models (leave unused provider secrets blank)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DB_FILE=bot_data.db
OPENROUTER_MODEL=
CEREBRAS_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
GROQ_BASE_URL=
GROQ_STT_MODEL=
GEMINI_MUSIC_MODEL=
GEMINI_STT_MODEL=
GEMINI_VIDEO_MODEL=

# Media / vision / maps
GOOGLE_MAPS_API_KEY=
LOCAL_IMAGE_API_URL=
LOCAL_IMAGE_MODEL_PATH=
LOCAL_IMAGE_MODEL_PATHS=
LOCAL_IMAGE_WIDTH=1024
LOCAL_IMAGE_HEIGHT=1024
LOCAL_IMAGE_STEPS=20
LOCAL_VISION_MODEL_PATH=
VISION_HTTP_TIMEOUT=30
VISION_MAX_QUERIES=5
VISION_MAX_RESULTS=5
VISION_SEARCH_REGION=
POLLINATIONS_IMAGE_MODEL=
POLLINATIONS_IMAGE_WIDTH=1024
POLLINATIONS_IMAGE_HEIGHT=1024
TESSERACT_CMD=

# Speech
STT_LANGUAGE=fa
TTS_VOICE=

# Plugins / operations
PLUGINS_DISABLED=
BACKUP_REMOTE_TIMEOUT=30

# Observability / deployment metadata
METRICS_TOKEN=
STARTUP_CHECK=true
RELEASE_VERSION=58.0.0
RENDER_GIT_COMMIT=
